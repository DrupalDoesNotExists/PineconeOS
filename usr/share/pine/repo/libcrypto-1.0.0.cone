---FILE /usr/lib/libcrypto.lua 0755 1255 2cdd630f src---
--[[
  libcrypto — Cryptographic utilities for PineconeOS
  ====================================================
  FNV-1a 32-bit hash and password hashing.

  Usage: local crypto = require("libcrypto")
         local h = crypto.fnv1a("hello")
         local p = crypto.hash_password("pinecone")
]]

local M = {}

-- Arithmetic bxor (works in KNUCK sandbox and pure Lua 5.2)
local function bxor(a, b)
  local r, bit = 0, 1
  a = a % 0x100000000; b = b % 0x100000000
  while a > 0 or b > 0 do
    if (a % 2) ~= (b % 2) then r = r + bit end
    a = math.floor(a / 2); b = math.floor(b / 2); bit = bit * 2
  end
  return r
end

-- FNV-1a 32-bit hash → 8-char hex string
-- Uses 16-bit-split multiply to avoid float precision loss in Lua 5.2/Cobalt
function M.fnv1a(data)
  local h = 0x811c9dc5
  for i = 1, #data do
    h = bxor(h, string.byte(data, i))
    local lo = h % 0x10000
    local hi = (h - lo) / 0x10000
    local plo = 0x01000193 % 0x10000
    local phi = (0x01000193 - plo) / 0x10000
    local r = lo * plo + ((lo * phi + hi * plo) % 0x10000) * 0x10000
    h = r % 0x100000000
  end
  return string.format("%08x", h)
end

-- Hash a password (FNV-1a wrapper)
function M.hash_password(pass)
  return M.fnv1a(tostring(pass or ""))
end

return M
---END PKG---
