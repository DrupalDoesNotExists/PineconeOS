---FILE /usr/lib/libbase.lua 0755 6902 b2260d7d src---
--[[
  libbase — Base utilities for PineconeOS
  ========================================
  Bit ops, checksums, byte-order helpers.
  Usable in KNUCK sandbox (bit lib) or pure Lua 5.2 fallback.

  Usage: local base = require("libbase")
]]

local bit_ok, bit_lib = pcall(require, "bit")
if not (bit_ok and type(bit_lib) == "table" and bit_lib.band) then
  bit_lib = nil
end

local M = {}

-- ================================================================
-- 1. Bit utilities
-- ================================================================

if bit_lib then
  -- CC:Tweaked or host bit32 — direct wrappers
  M.band = bit_lib.band
  M.bor  = bit_lib.bor
  M.bxor = bit_lib.bxor
  M.bnot = bit_lib.bnot
else
  -- Pure-arithmetic fallback (32-bit range)
  M.band = function(a, b)
    local r, bit = 0, 1
    a = a % 0x100000000; b = b % 0x100000000
    while a > 0 and b > 0 do
      if a % 2 == 1 and b % 2 == 1 then r = r + bit end
      a = math.floor(a / 2)
      b = math.floor(b / 2)
      bit = bit * 2
    end
    return r
  end

  M.bor = function(a, b)
    local r, bit = 0, 1
    a = a % 0x100000000; b = b % 0x100000000
    while a > 0 or b > 0 do
      if a % 2 == 1 or b % 2 == 1 then r = r + bit end
      a = math.floor(a / 2)
      b = math.floor(b / 2)
      bit = bit * 2
    end
    return r
  end

  M.bxor = function(a, b)
    local r, bit = 0, 1
    a = a % 0x100000000; b = b % 0x100000000
    while a > 0 or b > 0 do
      if (a % 2) ~= (b % 2) then r = r + bit end
      a = math.floor(a / 2)
      b = math.floor(b / 2)
      bit = bit * 2
    end
    return r
  end

  M.bnot = function(x)
    return (0xFFFFFFFF - (x % 0x100000000)) % 0x100000000
  end
end

-- Shift left (logical)
function M.shl(x, n)
  return (x * (2 ^ n)) % 0x100000000
end

-- Shift right (logical)
function M.shr(x, n)
  return math.floor((x % 0x100000000) / (2 ^ n))
end

-- Arithmetic right shift (sign-extending)
function M.arshift(x, n)
  x = x % 0x100000000
  if x >= 0x80000000 then
    local shifted = M.shr(x, n)
    local fill = M.bnot(M.shl(0xFFFFFFFF, 32 - n)) % 0x100000000
    return M.bor(shifted, fill)
  end
  return M.shr(x, n)
end

-- Sign extend from width bits
function M.sx(v, w)
  v = v % (2 ^ w)
  if v >= (2 ^ (w - 1)) then return v - (2 ^ w) end
  return v
end

function M.sx32(v) return M.sx(v, 32) end

-- Unsigned clamp to 32 bits
function M.ux(v) return v % 0x100000000 end

-- 32×32 unsigned multiply, lower 32 bits (16-bit split for double range)
function M.mul32lo(a, b)
  a = a % 0x100000000; b = b % 0x100000000
  local al = a % 0x10000; local ah = math.floor(a / 0x10000) % 0x10000
  local bl = b % 0x10000; local bh = math.floor(b / 0x10000) % 0x10000
  local lo = al * bl
  local mid = al * bh + ah * bl
  return (lo + (mid % 0x10000) * 0x10000) % 0x100000000
end

-- 32×32 unsigned multiply, upper 32 bits
function M.mul32hi_uu(a, b)
  a = a % 0x100000000; b = b % 0x100000000
  local al = a % 0x10000; local ah = math.floor(a / 0x10000) % 0x10000
  local bl = b % 0x10000; local bh = math.floor(b / 0x10000) % 0x10000
  local lo = al * bl
  local mid = al * bh + ah * bl
  local hi = ah * bh + math.floor(mid / 0x10000)
  return (hi + math.floor(lo / 0x100000000)) % 0x100000000
end

-- 32×32 signed multiply, upper 32 bits
function M.mul32hi_ss(a, b)
  a = M.sx32(a); b = M.sx32(b)
  local neg = (a < 0) ~= (b < 0)
  a = math.abs(a); b = math.abs(b)
  local al = a % 0x10000; local ah = math.floor(a / 0x10000)
  local bl = b % 0x10000; local bh = math.floor(b / 0x10000)
  local lo = al * bl; local mid = al * bh + ah * bl
  local hi = ah * bh + math.floor(mid / 0x10000) + math.floor(lo / 0x100000000)
  if neg then hi = (2 ^ 32 - hi) % (2 ^ 32) end
  return hi % 0x100000000
end

-- 32×32 signed×unsigned multiply, upper 32 bits
function M.mul32hi_su(a, b)
  local sa = M.sx32(a)
  local neg = (sa < 0)
  local apos = math.abs(sa)
  local bval = b % 0x100000000
  local al = apos % 0x10000; local ah = math.floor(apos / 0x10000)
  local bl = bval % 0x10000; local bh = math.floor(bval / 0x10000)
  local lo = al * bl; local mid = al * bh + ah * bl
  local hi = ah * bh + math.floor(mid / 0x10000) + math.floor(lo / 0x100000000)
  if neg then hi = (2 ^ 32 - hi) % (2 ^ 32) end
  return hi % 0x100000000
end

-- ================================================================
-- 2. Byte-order helpers (network = big-endian)
-- ================================================================

-- uint16 big-endian: two bytes → number
function M.ntohs(s, off)
  off = off or 1
  return s:byte(off) * 256 + s:byte(off + 1)
end

-- uint32 big-endian: four bytes → number
function M.ntohl(s, off)
  off = off or 1
  return s:byte(off) * 16777216 + s:byte(off + 1) * 65536
    + s:byte(off + 2) * 256 + s:byte(off + 3)
end

-- number → 2-byte big-endian string
function M.htons(n)
  n = n % 0x10000
  return string.char(math.floor(n / 256), n % 256)
end

-- number → 4-byte big-endian string
function M.htonl(n)
  n = n % 0x100000000
  return string.char(
    math.floor(n / 16777216) % 256,
    math.floor(n / 65536) % 256,
    math.floor(n / 256) % 256,
    n % 256)
end

-- ================================================================
-- 3. Checksum helpers
-- ================================================================

-- RFC 1071 IP checksum (ones-complement sum of 16-bit words)
function M.ip_checksum(header)
  local sum = 0
  for i = 1, #header, 2 do
    local hi = header:byte(i) or 0
    local lo = header:byte(i + 1) or 0
    sum = sum + hi * 256 + lo
  end
  while sum > 0xFFFF do
    sum = (sum % 0x10000) + math.floor(sum / 0x10000)
  end
  return M.bxor(sum, 0xFFFF)
end

-- TCP/UDP pseudo-header checksum.
-- proto: IPPROTO_TCP (6) or IPPROTO_UDP (17)
function M.pseudo_checksum(src_ip, dest_ip, proto, payload)
  local len = #payload
  local pseudo = src_ip .. dest_ip
    .. string.char(0, proto, math.floor(len / 256), len % 256)
  local seg = pseudo .. payload
  local sum = 0
  for i = 1, #seg, 2 do
    local hi = seg:byte(i) or 0
    local lo = seg:byte(i + 1) or 0
    sum = sum + hi * 256 + lo
  end
  while sum > 0xFFFF do
    sum = (sum % 0x10000) + math.floor(sum / 0x10000)
  end
  return M.bxor(sum, 0xFFFF)
end

-- ================================================================
-- 4. IP address helpers
-- ================================================================

-- 4-byte string → "a.b.c.d"
function M.ip_to_str(ip)
  return string.format("%d.%d.%d.%d", ip:byte(1), ip:byte(2), ip:byte(3), ip:byte(4))
end

-- "a.b.c.d" → 4-byte string or nil
function M.str_to_ip(s)
  local a, b, c, d = s:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
  if not a then return nil end
  a, b, c, d = tonumber(a), tonumber(b), tonumber(c), tonumber(d)
  if not (a and b and c and d) then return nil end
  if a > 255 or b > 255 or c > 255 or d > 255 then return nil end
  return string.char(a, b, c, d)
end

return M
---END PKG---
